{
  "name": "notex",
  "version": "0.0.15",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:dmg": "pnpm check && pnpm exec tauri build --bundles dmg --no-sign && shasum -a 256 src-tauri/target/release/bundle/dmg/*.dmg",
    "release": "node scripts/release.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "check:frontend": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:rust": "cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm check:frontend && pnpm check:rust"
  },
  "dependencies": {
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@element-plus/icons-vue": "2.3.2",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "element-plus": "2.14.3",
    "pinia": "4.0.2",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.1.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "code-inspector-plugin": "2.0.4",
    "jsdom": "29.1.1",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "sass": "1.101.3",
    "typescript": "5.9.3",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  }
}
