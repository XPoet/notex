{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "NoteX 主窗口最小权限集。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "window-state:default"
  ]
}
