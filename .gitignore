# Git 忽略规则。

# Java
target/
dist/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
/dist-ssr
/tmp
/out-tsc

# 依赖目录
node_modules

# 其他包管理器锁文件
yarn.lock
package-lock.json

# IDE 与编辑器
.idea
.project
.classpath
.c9
*.launch
.settings/
*.sublime-workspace

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
# !.vscode/tasks.json
# !.vscode/launch.json

# 其他临时文件
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
testem.log

# 端到端测试产物
/e2e/src/*.js
/e2e/src/*.map
/cypress/screenshots

# 系统文件
.DS_Store
Thumbs.db

# 本地环境文件
*.local
.pnpm-store

